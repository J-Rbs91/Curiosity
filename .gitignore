# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/native/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Capacitor Android : généré reproductiblement par `npm run android:sync`
/native/android/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# corpus : dossiers remis au contrôleur aveugle, régénérables (npm run corpus:brief)
corpus/review/*.brief.json

# corpus : partitions de bundle, derivees de verification-bundle.json par
# scripts/corpus/factcheck-partition.mjs, regenerables a l'identique
corpus/deepening-audits/work/*/verification-bundle.part*.json

# corpus : scripts de travail deposes par les agents dans le repertoire d'une carte.
# Les artefacts du protocole (audit.md, rewrite.md, factcheck-pack.json, claim-map.json,
# verification-bundle.json, verification.json, factcheck-gate.json, review.md) sont suivis ;
# l'outillage jetable qui les produit ne l'est pas, et il doit porter le conceptId de sa
# carte pour que deux agents paralleles ne s'ecrasent pas (chantier O).
corpus/deepening-audits/work/*/*.py
