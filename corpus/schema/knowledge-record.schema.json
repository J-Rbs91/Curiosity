{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curiosity.local/schema/knowledge-record.schema.json",
  "title": "Verified concept knowledge record",
  "type": "object",
  "required": ["protocol_version", "id", "discipline", "status", "evidence_sha256", "evidence_review_sha256", "claims", "boundaries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "protocol_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "discipline": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "const": "VERIFIED" },
    "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_review_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "mode", "kind", "support_ids", "verdict"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^KCL-[A-F0-9]{12}$" },
          "text": { "type": "string", "minLength": 1 },
          "mode": {
            "enum": ["DOCUMENTARY", "FORMAL", "EMPIRICAL", "COMPUTATIONAL", "CONSENSUS"]
          },
          "kind": {
            "enum": ["FACT", "DEFINITION", "ATTRIBUTION", "RELATION", "LIMIT", "INTERPRETATION", "DERIVED_CONSEQUENCE", "BIBLIOGRAPHIC"]
          },
          "support_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SUP-[a-f0-9]{16}$" }
          },
          "verdict": { "const": "SUPPORTED" }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "reason"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "created_at": { "type": ["string", "null"] }
  }
}
