    {
      "claim_id": "C011",
      "locator": "sections[0].paragraphs[0]",
      "start": 295,
      "end": 642,
      "claim_text": "Campbell l’écrit à la première personne : « I come to the following pessimistic laws (at least for the U.S. scene): The more any quantitative social indicator is used for social decision-making, the more subject it will be to corruption pressures and the more apt it will be to distort and corrupt the social processes it is intended to monitor. »",
      "normalized_claim": "Citation verbatim, à la première personne.",
      "support_ids": [
        "SUP-d345ba51ac96ca45",
        "SUP-29a1e32a461f8011",
        "SUP-8b69ab8b0bc7c4dd",
        "SUP-95d15e06e804892d"
      ]
    },
    {
      "claim_id": "C012",
      "locator": "sections[0].paragraphs[0]",
      "start": 643,
      "end": 695,
      "claim_text": "Il enchaîne par « Let me illustrate these two laws »",
      "normalized_claim": "Phrase suivante verbatim.",
      "support_ids": [
        "SUP-02c2b6df473a9c3d"
      ]
    },
    {
      "claim_id": "C013",
      "locator": "sections[0].paragraphs[0]",
      "start": 698,
      "end": 734,
      "claim_text": "il ne voit pas là une loi, mais deux",
      "normalized_claim": "Campbell compte deux lois.",
      "support_ids": [
        "SUP-44e43baae10fe353",
        "SUP-02c2b6df473a9c3d"
      ]
    },
    {
      "claim_id": "C014",
      "locator": "sections[0].paragraphs[1]",
      "start": 0,
      "end": 122,
      "claim_text": "La première porte sur l’indicateur lui-même : plus il pèse sur les décisions, plus il subit de pressions pour être faussé.",
      "normalized_claim": "Premier versant.",
      "support_ids": [
        "SUP-44e43baae10fe353",
        "SUP-d345ba51ac96ca45"
      ]
    },
    {
      "claim_id": "C015",
      "locator": "sections[0].paragraphs[1]",
      "start": 123,
      "end": 242,
      "claim_text": "La seconde porte sur ce qu’il mesure : il finit par déformer et corrompre les processus sociaux qu’il devait surveiller",
      "normalized_claim": "Second versant.",
      "support_ids": [
        "SUP-44e43baae10fe353",
        "SUP-d345ba51ac96ca45"
      ]
    },
    {
      "claim_id": "C016",
      "locator": "sections[0].paragraphs[1]",
      "start": 244,
      "end": 324,
      "claim_text": "comme l’activité du centre d’appel imaginé plus haut, qui se plie au chronomètre",
      "normalized_claim": "La vignette illustre le second versant.",
      "support_ids": [
        "SUP-44e43baae10fe353"
      ]
    },
    {
      "claim_id": "C017",
      "locator": "sections[0].paragraphs[1]",
      "start": 326,
      "end": 377,
      "claim_text": "Campbell tient à ce que les deux restent distinctes",
      "normalized_claim": "Campbell tient à la distinction.",
      "support_ids": [
        "SUP-44e43baae10fe353"
      ]
    },
    {
      "claim_id": "C018",
      "locator": "sections[0].paragraphs[1]",
      "start": 382,
      "end": 484,
      "claim_text": "c’est la seconde, la déformation de la réalité surveillée, que le nom du concept porte le plus souvent",
      "normalized_claim": "Le nom porte surtout le second versant.",
      "support_ids": [
        "SUP-8b69ab8b0bc7c4dd"
      ]
