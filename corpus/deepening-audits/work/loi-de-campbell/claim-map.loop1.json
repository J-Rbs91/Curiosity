      ]
    },
    {
      "claim_id": "C023",
      "locator": "sections[1].paragraphs[0]",
      "start": 0,
      "end": 234,
      "claim_text": "Le raisonnement part d’un constat : certains indicateurs produits par les sciences sociales, comme les indices du chômage et du coût de la vie du Bureau of Labor Statistics, sont devenus des pièces régulières de la décision politique.",
      "normalized_claim": "Point de départ BLS.",
      "support_ids": [
        "SUP-44e43baae10fe353"
      ]
    },
    {
      "claim_id": "C024",
      "locator": "sections[1].paragraphs[0]",
      "start": 235,
      "end": 400,
      "claim_text": "Campbell propose alors de les considérer « as akin to voting in political elections », c’est-à-dire comme des enjeux de pouvoir plutôt que comme des relevés neutres.",
      "normalized_claim": "Analogie avec le vote.",
      "support_ids": [
        "SUP-44e43baae10fe353"
      ]
    },
    {
      "claim_id": "C025",
      "locator": "sections[1].paragraphs[0]",
      "start": 401,
      "end": 548,
      "claim_text": "Cette perspective élargie, il la dit soutenue par les études sociologiques qualitatives sur la façon dont se fabriquent les statistiques publiques.",
      "normalized_claim": "Appui des études qualitatives.",
      "support_ids": [
        "SUP-44e43baae10fe353"
      ]
    },
    {
      "claim_id": "C026",
      "locator": "sections[1].paragraphs[1]",
      "start": 0,
      "end": 39,
      "claim_text": "Il en donne une illustration à Chicago.",
