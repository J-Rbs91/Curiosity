        "SUP-44e43baae10fe353"
      ]
    },
    {
      "claim_id": "C030",
      "locator": "sections[1].paragraphs[1]",
      "start": 343,
      "end": 473,
      "claim_text": "Cela implique que la surveillance d’un chiffre ne suffit pas à le garder fiable : ce qui le menace, c’est ce qu’on décide avec lui",
