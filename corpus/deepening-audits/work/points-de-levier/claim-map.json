  "claims": [
    {
      "claim_id": "C001",
      "locator": "lead[0]",
      "start": 0,
      "end": 79,
      "claim_text": "Devant un ensemble qui fonctionne mal, la question pratique est « où appuyer ».",
      "normalized_claim": "La question pratique devant un système défaillant est où intervenir.",
      "support_ids": [
        "SUP-ebb398acd46edf3d"
      ]
    },
    {
      "claim_id": "C002",
      "locator": "lead[0]",
      "start": 80,
      "end": 187,
      "claim_text": "On peut changer un montant, un délai, une règle, la personne qui décide, ou le but que l’ensemble poursuit.",
      "normalized_claim": "Ces gestes correspondent à des niveaux de la liste : paramètres, délais, règles, acteurs, buts.",
      "support_ids": [
        "SUP-a169d25e5e6fbc96",
        "SUP-a63a2642d8b852de"
      ]
    },
    {
      "claim_id": "C003",
      "locator": "lead[0]",
      "start": 188,
      "end": 249,
      "claim_text": "Ces gestes ne demandent ni le même effort ni la même autorité",
      "normalized_claim": "Les interventions diffèrent par la difficulté et le pouvoir requis.",
      "support_ids": [
        "SUP-5bd5758b923ca76e",
        "SUP-00cbb4a2f594de25",
        "SUP-3256fcc2ee6897d1",
        "SUP-a63a2642d8b852de"
      ]
    },
    {
      "claim_id": "C004",
      "locator": "lead[0]",
      "start": 254,
      "end": 290,
      "claim_text": "ils n’ont surtout pas la même portée",
      "normalized_claim": "Les interventions ont une efficacité inégale.",
      "support_ids": [
        "SUP-3a36c7316132dc8f",
        "SUP-a169d25e5e6fbc96"
      ]
    },
    {
      "claim_id": "C005",
      "locator": "lead[1]",
      "start": 0,
      "end": 81,
      "claim_text": "Donella H. Meadows, formée à la dynamique des systèmes auprès de Jay W. Forrester",
      "normalized_claim": "Meadows a été formée par Forrester.",
      "support_ids": [
        "SUP-7225770a44d11547",
        "SUP-97cc6a5e88c9487f"
      ]
    },
    {
      "claim_id": "C006",
      "locator": "lead[1]",
      "start": 83,
      "end": 288,
      "claim_text": "appelle points de levier les endroits d’un système complexe (une entreprise, une économie, un corps vivant, une ville, un écosystème) où « a small shift in one thing can produce big changes in everything »",
      "normalized_claim": "Définition de Meadows, p. 1.",
      "support_ids": [
        "SUP-7262836278f47a70",
        "SUP-e7d18f493fc9bcee"
      ]
    },
    {
      "claim_id": "C007",
      "locator": "lead[1]",
      "start": 290,
      "end": 365,
      "claim_text": "Elle en a dressé une liste de douze, rangés du plus faible au plus puissant",
      "normalized_claim": "Liste de douze en ordre croissant d’efficacité.",
      "support_ids": [
        "SUP-3a36c7316132dc8f",
        "SUP-7262836278f47a70",
        "SUP-8c80540dcb2e6c7c",
        "SUP-a169d25e5e6fbc96"
      ]
    },
    {
      "claim_id": "C008",
      "locator": "lead[1]",
      "start": 367,
      "end": 457,
      "claim_text": "et l’a assortie d’un avertissement : ces endroits, on les actionne d’ordinaire à l’envers.",
      "normalized_claim": "Avertissement : on les utilise à l’envers.",
      "support_ids": [
        "SUP-3a36c7316132dc8f",
        "SUP-52c992afba49b58c",
        "SUP-2c77089b1d953778",
        "SUP-c9a7470063381cd6",
        "SUP-0737373741370080",
        "SUP-5acb1cee3a00e887"
      ]
    },
    {
      "claim_id": "C009",
      "locator": "sections[0].paragraphs[0]",
      "start": 0,
      "end": 132,
      "claim_text": "La liste est donnée « in increasing order of effectiveness » : le numéro 12 est le levier le plus faible et le numéro 1 le plus fort",
      "normalized_claim": "Ordre croissant, 12 le plus faible.",
      "support_ids": [
        "SUP-7262836278f47a70",
        "SUP-8c80540dcb2e6c7c",
        "SUP-a169d25e5e6fbc96"
      ]
    },
    {
      "claim_id": "C010",
      "locator": "sections[0].paragraphs[0]",
      "start": 134,
      "end": 198,
      "claim_text": "l’inverse de ce qu’une liste numérotée suggère au premier regard",
      "normalized_claim": "Contre-intuitif pour un lecteur de liste numérotée.",
      "support_ids": [
        "SUP-8c80540dcb2e6c7c"
      ]
    },
    {
      "claim_id": "C011",
      "locator": "sections[0].paragraphs[0]",
      "start": 200,
      "end": 248,
      "claim_text": "Tout en bas, « Constants, parameters, numbers ».",
      "normalized_claim": "Entrée 12.",
      "support_ids": [
        "SUP-2d9cb5d014d223bd",
        "SUP-a169d25e5e6fbc96"
      ]
    },
    {
      "claim_id": "C012",
      "locator": "sections[0].paragraphs[0]",
      "start": 249,
      "end": 670,
      "claim_text": "Puis, en montant : la taille des réserves tampons, la structure physique des stocks et des flux, la longueur des délais, la force des boucles qui corrigent, le gain des boucles qui entraînent, la structure des flux d’information, les règles, le pouvoir d’ajouter, de changer, de faire évoluer ou d’auto-organiser la structure, les buts du système, le paradigme d’où il sort, et enfin « The power to transcend paradigms ».",
      "normalized_claim": "Entrées 11 à 1.",
      "support_ids": [
        "SUP-2d9cb5d014d223bd",
        "SUP-a169d25e5e6fbc96"
      ]
    },
    {
      "claim_id": "C013",
      "locator": "sections[0].paragraphs[1]",
      "start": 0,
      "end": 80,
      "claim_text": "Meadows file toute l’échelle avec une image de plomberie, celle d’une baignoire.",
      "normalized_claim": "Image filée de la baignoire.",
      "support_ids": [
        "SUP-3ffaa707ee114434",
        "SUP-45ba50b7769e8088"
      ]
    },
    {
      "claim_id": "C014",
      "locator": "sections[0].paragraphs[1]",
      "start": 81,
      "end": 179,
      "claim_text": "Ce qui compte dans un système est un stock, comme l’eau derrière un barrage ou l’argent en banque.",
      "normalized_claim": "État du système = stock.",
      "support_ids": [
        "SUP-0848de8c3867605b"
      ]
    },
    {
      "claim_id": "C015",
      "locator": "sections[0].paragraphs[1]",
      "start": 180,
      "end": 247,
      "claim_text": "Des flux entrants le font monter, des flux sortants le font baisser",
      "normalized_claim": "Flux entrants/sortants.",
      "support_ids": [
        "SUP-5ea1e91179a4b4d4"
      ]
    },
    {
      "claim_id": "C016",
      "locator": "sections[0].paragraphs[1]",
      "start": 249,
      "end": 338,
      "claim_text": "et il faut du temps pour qu’ils s’y accumulent, comme pour remplir ou vider la baignoire.",
      "normalized_claim": "Accumulation prend du temps.",
      "support_ids": [
        "SUP-45ba50b7769e8088"
      ]
    },
    {
      "claim_id": "C017",
      "locator": "sections[0].paragraphs[1]",
      "start": 339,
      "end": 470,
      "claim_text": "Deux boucles correctrices, l’une sur l’arrivée d’eau, l’autre sur la sortie, permettent d’amener le niveau au but qu’on s’est fixé.",
      "normalized_claim": "Deux boucles négatives.",
      "support_ids": [
        "SUP-92bceffd56f1b8ed"
      ]
    },
    {
      "claim_id": "C018",
      "locator": "sections[0].paragraphs[2]",
      "start": 0,
      "end": 111,
      "claim_text": "Puis elle fait remarquer : « Notice that the goal and the feedback connections are not visible in the system. »",
      "normalized_claim": "Citation p. 4.",
      "support_ids": [
        "SUP-b3263903ec60b7fe"
      ]
    },
    {
      "claim_id": "C019",
      "locator": "sections[0].paragraphs[2]",
      "start": 112,
      "end": 175,
      "claim_text": "Ce qui règle le niveau est donc justement ce qu’on ne voit pas.",
      "normalized_claim": "Dérivé : but et boucles invisibles règlent le niveau.",
      "support_ids": [
        "SUP-92bceffd56f1b8ed",
        "SUP-b3263903ec60b7fe"
      ]
    },
    {
      "claim_id": "C020",
      "locator": "sections[0].paragraphs[2]",
      "start": 176,
      "end": 273,
      "claim_text": "Elle en tire la conclusion à la page suivante : « That’s why leverage points are not intuitive. »",
      "normalized_claim": "Citation p. 5, page suivant p. 4.",
      "support_ids": [
        "SUP-b3263903ec60b7fe",
        "SUP-655dfcede1c2acdf"
      ]
    },
    {
      "claim_id": "C021",
      "locator": "sections[1].paragraphs[0]",
      "start": 0,
      "end": 128,
      "claim_text": "Dans le jargon des systèmes, un paramètre est le nombre qui détermine « how much of a discrepancy turns which faucet how fast ».",
      "normalized_claim": "Définition du paramètre.",
      "support_ids": [
        "SUP-55531336999abd7e"
      ]
    },
    {
      "claim_id": "C022",
      "locator": "sections[1].paragraphs[0]",
      "start": 129,
      "end": 229,
      "claim_text": "Meadows prend le cas de la dette publique, qu’elle décrit comme « a negative bathtub, a money hole »",
      "normalized_claim": "Dette publique.",
      "support_ids": [
        "SUP-3ffaa707ee114434",
        "SUP-ef6279ab526086e2"
      ]
    },
    {
      "claim_id": "C023",
      "locator": "sections[1].paragraphs[0]",
      "start": 232,
      "end": 300,
      "claim_text": "les recettes fiscales la font remonter, les dépenses la font baisser",
      "normalized_claim": "Recettes/dépenses.",
      "support_ids": [
        "SUP-ef6279ab526086e2"
      ]
    },
    {
      "claim_id": "C024",
      "locator": "sections[1].paragraphs[0]",
      "start": 302,
      "end": 441,
      "claim_text": "et le Congrès et le Président passent l’essentiel de leur temps à débattre des innombrables paramètres qui ouvrent et ferment ces robinets.",
      "normalized_claim": "Congrès et Président.",
      "support_ids": [
        "SUP-3ffaa707ee114434",
        "SUP-ef6279ab526086e2"
      ]
    },
    {
      "claim_id": "C025",
      "locator": "sections[1].paragraphs[0]",
      "start": 442,
      "end": 557,
      "claim_text": "Et pourtant, quel que soit le parti au pouvoir, le trou continue de se creuser, seulement à des rythmes différents.",
      "normalized_claim": "Le trou se creuse quel que soit le parti.",
      "support_ids": [
        "SUP-ef6279ab526086e2"
      ]
    },
    {
      "claim_id": "C026",
      "locator": "sections[1].paragraphs[1]",
      "start": 0,
      "end": 56,
      "claim_text": "Meadows les tient pour « the points of least leverage ».",
      "normalized_claim": "Moindre levier.",
      "support_ids": [
        "SUP-3ad405d655d49237"
      ]
    },
    {
      "claim_id": "C027",
      "locator": "sections[1].paragraphs[1]",
      "start": 57,
      "end": 142,
      "claim_text": "Probablement 90, non, 95, non, 99 % de notre attention, écrit-elle, va aux paramètres",
      "normalized_claim": "90-95-99 %.",
      "support_ids": [
        "SUP-3ad405d655d49237"
      ]
    },
    {
      "claim_id": "C028",
      "locator": "sections[1].paragraphs[1]",
      "start": 145,
      "end": 195,
      "claim_text": "autant ranger les transats sur le pont du Titanic.",
      "normalized_claim": "Image du Titanic.",
      "support_ids": [
        "SUP-3ad405d655d49237"
      ]
    },
    {
      "claim_id": "C029",
      "locator": "sections[1].paragraphs[1]",
      "start": 196,
      "end": 341,
      "claim_text": "Ce n’est pas qu’ils soient sans importance : ils peuvent compter, surtout à court terme et pour la personne qui se tient directement dans le flux",
      "normalized_claim": "Importance à court terme.",
      "support_ids": [
        "SUP-64bcbfebed301d75"
      ]
    },
    {
      "claim_id": "C030",
      "locator": "sections[1].paragraphs[1]",
      "start": 343,
      "end": 391,
      "claim_text": "et l’on se livre pour eux des batailles féroces.",
      "normalized_claim": "Batailles féroces.",
      "support_ids": [
        "SUP-64bcbfebed301d75"
      ]
    },
    {
      "claim_id": "C031",
      "locator": "sections[1].paragraphs[1]",
      "start": 392,
      "end": 436,
      "claim_text": "Mais ils changent rarement les comportements",
      "normalized_claim": "Changent rarement le comportement.",
      "support_ids": [
        "SUP-64bcbfebed301d75"
      ]
    },
    {
      "claim_id": "C032",
      "locator": "sections[1].paragraphs[1]",
      "start": 439,
      "end": 533,
      "claim_text": "ils relancent rarement un système enlisé, et ne freinent pas celui qui croît hors de contrôle.",
      "normalized_claim": "Stagnant / hors contrôle.",
      "support_ids": [
        "SUP-1cb2a360fe47c52d"
      ]
    },
    {
      "claim_id": "C033",
      "locator": "sections[1].paragraphs[2]",
      "start": 0,
      "end": 145,
      "claim_text": "Il y a une exception : un paramètre devient un levier quand il entre dans une plage qui déclenche l’un des niveaux situés plus haut sur la liste.",
      "normalized_claim": "Exception des plages critiques.",
      "support_ids": [
        "SUP-f9d8def49ae3267f"
      ]
    },
    {
      "claim_id": "C034",
      "locator": "sections[1].paragraphs[2]",
      "start": 146,
      "end": 226,
      "claim_text": "Mais ces valeurs critiques sont bien moins fréquentes qu’on ne semble le croire.",
      "normalized_claim": "Rares.",
      "support_ids": [
        "SUP-71b8abf2fc83138f"
      ]
    },
    {
      "claim_id": "C035",
      "locator": "sections[1].paragraphs[2]",
      "start": 227,
      "end": 310,
      "claim_text": "La plupart du temps, conclut-elle, les chiffres ne valent pas la sueur qu’on y met.",
      "normalized_claim": "Pas la sueur.",
      "support_ids": [
        "SUP-71b8abf2fc83138f"
      ]
    },
    {
      "claim_id": "C036",
      "locator": "sections[2].paragraphs[0]",
      "start": 88,
      "end": 204,
      "claim_text": "Meadows en place pourtant certains en fonction de la difficulté qu’il y a à les changer, à commencer par les délais.",
      "normalized_claim": "Certains niveaux classés selon la difficulté de changement, dont les délais.",
      "support_ids": [
        "SUP-5bd5758b923ca76e",
        "SUP-00cbb4a2f594de25",
        "SUP-1038537805616f0f",
        "SUP-e630e93572303ddb"
      ]
    },
    {
      "claim_id": "C037",
      "locator": "sections[2].paragraphs[0]",
      "start": 205,
      "end": 317,
      "claim_text": "Si l’on ne reçoit sur l’état d’un système qu’une information en retard, on dépasse le but, puis on reste en deçà",
      "normalized_claim": "Overshoot/undershoot.",
      "support_ids": [
        "SUP-037181d89d0fbcbe"
      ]
    },
    {
      "claim_id": "C038",
      "locator": "sections[2].paragraphs[0]",
      "start": 320,
      "end": 473,
      "claim_text": "dans un système qui comporte un seuil au-delà duquel les dommages deviennent irréversibles, des délais trop longs provoquent dépassement et effondrement.",
      "normalized_claim": "Overshoot and collapse.",
      "support_ids": [
        "SUP-1c2091036ee7af6d"
      ]
    },
    {
      "claim_id": "C039",
      "locator": "sections[2].paragraphs[0]",
      "start": 474,
      "end": 600,
      "claim_text": "Elle écrit qu’elle classerait la longueur des délais parmi les leviers forts, si les délais étaient souvent faciles à changer.",
      "normalized_claim": "Délais.",
      "support_ids": [
        "SUP-5bd5758b923ca76e"
      ]
    },
    {
      "claim_id": "C040",
      "locator": "sections[2].paragraphs[1]",
      "start": 0,
      "end": 115,
      "claim_text": "La structure physique est de même cruciale, mais rarement un levier, parce qu’il est rarement simple de la changer.",
      "normalized_claim": "Structure physique.",
      "support_ids": [
        "SUP-00cbb4a2f594de25"
      ]
    },
    {
      "claim_id": "C041",
      "locator": "sections[2].paragraphs[1]",
      "start": 116,
      "end": 179,
      "claim_text": "Le levier, écrit-elle, est dans une bonne conception au départ.",
      "normalized_claim": "Proper design.",
      "support_ids": [
        "SUP-00cbb4a2f594de25"
      ]
    },
    {
      "claim_id": "C042",
      "locator": "sections[2].paragraphs[2]",
      "start": 0,
      "end": 53,
      "claim_text": "L’information, au sixième rang, offre le cas inverse.",
      "normalized_claim": "Information rang 6, facile à changer.",
      "support_ids": [
        "SUP-a169d25e5e6fbc96",
        "SUP-97f584c40df141b1"
      ]
    },
    {
      "claim_id": "C043",
      "locator": "sections[2].paragraphs[2]",
      "start": 54,
      "end": 118,
      "claim_text": "Meadows rapporte une histoire, introduite par « the story goes »",
      "normalized_claim": "The story goes.",
      "support_ids": [
        "SUP-3421b0f99f5dee77",
        "SUP-81014e24a6b284f3"
      ]
    },
    {
      "claim_id": "C044",
      "locator": "sections[2].paragraphs[2]",
      "start": 121,
      "end": 260,
      "claim_text": "dans un lotissement de maisons identiques, le compteur électrique était tantôt à la cave, tantôt dans l’entrée, sous les yeux des habitants",
      "normalized_claim": "Compteur.",
      "support_ids": [
        "SUP-81014e24a6b284f3"
      ]
    },
    {
      "claim_id": "C045",
      "locator": "sections[2].paragraphs[2]",
      "start": 263,
      "end": 329,
      "claim_text": "sans autre changement, la consommation y était inférieure de 30 %.",
      "normalized_claim": "30 %.",
      "support_ids": [
        "SUP-3421b0f99f5dee77",
        "SUP-81014e24a6b284f3"
      ]
    },
    {
      "claim_id": "C046",
      "locator": "sections[2].paragraphs[2]",
      "start": 330,
      "end": 491,
      "claim_text": "Ce n’est ni un réglage de paramètre ni le renforcement d’une boucle existante, écrit-elle : « It’s a new loop », qui porte l’information là où elle n’allait pas.",
      "normalized_claim": "New loop.",
      "support_ids": [
        "SUP-c15fd96c15a922a1"
      ]
    },
    {
      "claim_id": "C047",
      "locator": "sections[2].paragraphs[2]",
      "start": 492,
      "end": 612,
      "claim_text": "Rétablir une information manquante est d’ordinaire bien plus facile et moins cher que de reconstruire une infrastructure",
      "normalized_claim": "Easier and cheaper.",
      "support_ids": [
        "SUP-97f584c40df141b1"
      ]
    },
    {
      "claim_id": "C048",
      "locator": "sections[2].paragraphs[2]",
